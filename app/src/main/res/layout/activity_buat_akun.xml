<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:id="@+id/buatAkun">

    <!-- Logo Owelpay di atas -->
    <ImageView
        android:id="@+id/logo_owel"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:contentDescription="logo owelpay"
        android:src="@drawable/owelpay_logo"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="32dp"/>

    <!-- Judul Buat Akun -->
    <TextView
        android:id="@+id/title_register"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Buat Akun"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/logo_owel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"/>

    <!-- Logo ilustrasi akun -->
    <ImageView
        android:id="@+id/logo"
        android:layout_width="148dp"
        android:layout_height="139dp"
        android:contentDescription="logo ilustrasi akun"
        android:src="@drawable/daftar"
        app:layout_constraintTop_toBottomOf="@id/title_register"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"/>

    <!-- Input Nama -->
    <EditText
        android:id="@+id/input_number"
        android:layout_width="450dp"
        android:layout_height="48dp"
        android:hint="Masukkan Nama"
        android:inputType="textPersonName"
        android:padding="14dp"
        android:background="@drawable/edittext_border"
        app:layout_constraintTop_toBottomOf="@id/logo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp"/>

    <!-- Button Daftar -->
    <Button
        android:id="@+id/btn_daftar"
        android:layout_width="450dp"
        android:layout_height="48dp"
        android:text="Daftar"
        android:textStyle="bold"
        android:backgroundTint="#FFB4D9"
        app:layout_constraintTop_toBottomOf="@id/input_number"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
